{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "netlify/functions/**/*.ts",
    "tests/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.json"
  ]
}
